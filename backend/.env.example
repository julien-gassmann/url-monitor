APP_NAME="Follow Me - Monitoring App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_NAME=monitoring
DB_DATABASE=monitoring
DB_USERNAME=monitoring
DB_PASSWORD=password

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="follow-me@monitoring.com"
MAIL_FROM_NAME="Follow Me"

KEEP_ACCESS_TOKEN_IN_CACHE=false
TIME_TRAVELLER_MODE_ENABLED=false
SANCTUM_TTL=1800
