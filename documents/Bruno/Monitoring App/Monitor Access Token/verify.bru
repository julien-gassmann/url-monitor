meta {
  name: verify
  type: http
  seq: 1
}

get {
  url: {{base_url}}/tokens/verify/{{access_token}}
  body: none
  auth: none
}

script:post-response {
  if (res.body.data) {
    bru.setEnvVar("bearer_token", res.body.data.bearer.token);
    bru.setEnvVar("monitor_uuid", res.body.data.monitor_uuid);
  }
}
